# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Engine settings (defaults shown)
BOOMERANG_MODEL=claude-opus-5-5
BOOMERANG_LLM_MODE=record        # live | record | replay
BOOMERANG_CACHE_DIR=.cache/llm
BOOMERANG_RUNS_DIR=runs
BOOMERANG_MAX_FIX_ATTEMPTS=3

# Lab connection settings (match infra/lab.compose.yml)
LAB_AWS_ENDPOINT=http://127.0.0.1:4566
LAB_POSTGRES_ADMIN_URL=postgresql://boomerang:boomerang@127.0.0.1:5432/boomerang
LAB_S3_ENDPOINT=http://127.0.0.1:9000
LAB_S3_ACCESS_KEY_ID=boomerang
LAB_S3_SECRET_ACCESS_KEY=boomerang-secret
LAB_REDIS_URL=redis://127.0.0.1:6379/0
