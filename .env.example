# Copy to .env and fill in. Never commit .env.

# LLM (default: local Ollama)
BOOMERANG_LLM_PROVIDER=ollama          # ollama | anthropic (fallback)
BOOMERANG_MODEL=qwen2.5-coder:7b       # with anthropic: claude-opus-5-5
OLLAMA_HOST=http://127.0.0.1:11434   # Leaseweb server via SSH tunnel: http://127.0.0.1:11435 (docs/17)
BOOMERANG_LLM_LOCATION=local           # local | leaseweb (docs/17)
OLLAMA_KEEP_ALIVE=60m
ANTHROPIC_API_KEY=                     # only for the fallback

# Engine
BOOMERANG_LLM_MODE=record              # live | record | replay
BOOMERANG_CACHE_DIR=.cache/llm
BOOMERANG_RUNS_DIR=runs
BOOMERANG_MAX_FIX_ATTEMPTS=2
BOOMERANG_AUTO_APPROVE=false

# Fake AWS (moto)
LAB_AWS_ENDPOINT=http://127.0.0.1:4566
