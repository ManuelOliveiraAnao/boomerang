{
  "users": [
    {
      "name": "shoplite",
      "password": "{{ rabbit_password }}",
      "tags": []
    }
  ],
  "vhosts": [{"name": "shoplite"}],
  "permissions": [
    {
      "user": "shoplite",
      "vhost": "shoplite",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "order-events-dlq",
      "vhost": "shoplite",
      "durable": true,
      "arguments": {"x-queue-type": "quorum"}
    },
    {
      "name": "order-events",
      "vhost": "shoplite",
      "durable": true,
      "arguments": {
        "x-queue-type": "{{ order_events_queue_arguments['x-queue-type'] }}",
        "x-delivery-limit": {{ order_events_queue_arguments['x-delivery-limit'] }},
        "x-dead-letter-exchange": "{{ order_events_queue_arguments['x-dead-letter-exchange'] }}",
        "x-dead-letter-routing-key": "{{ order_events_queue_arguments['x-dead-letter-routing-key'] }}"
      }
    }
  ]
}
