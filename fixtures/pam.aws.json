{
  "pam_version": "0.2",
  "app_name": "ShopLite",
  "platform": "aws",
  "entrypoints": ["app.main:app"],
  "test_command": "pytest -q tests",
  "components": [
    {
      "id": "orders",
      "kind": "kv_table",
      "provider": "aws.dynamodb",
      "resource_name": "orders",
      "name_env_var": "ORDERS_TABLE",
      "partition_key": {"name": "order_id", "type": "S"},
      "sort_key": null,
      "indexes": [
        {
          "name": "customer_id-index",
          "partition_key": {"name": "customer_id", "type": "S"},
          "sort_key": null
        }
      ],
      "fifo": false,
      "max_receive_count": null,
      "visibility_timeout_s": null,
      "features": ["put", "get", "update", "delete", "query", "conditional_write", "gsi"],
      "usages": []
    },
    {
      "id": "receipts",
      "kind": "object_store",
      "provider": "aws.s3",
      "resource_name": "receipts",
      "name_env_var": "RECEIPTS_BUCKET",
      "features": ["put", "get"],
      "usages": []
    },
    {
      "id": "order_events",
      "kind": "queue",
      "provider": "aws.sqs",
      "resource_name": "order-events",
      "name_env_var": "ORDER_EVENTS_QUEUE",
      "fifo": false,
      "max_receive_count": 3,
      "visibility_timeout_s": 30,
      "features": ["send", "receive", "delete", "visibility_timeout", "dlq"],
      "usages": []
    },
    {
      "id": "receipt_thumbnailer",
      "kind": "function",
      "provider": "aws.lambda",
      "resource_name": "receipt-thumbnailer",
      "features": ["event_notification"],
      "usages": []
    },
    {
      "id": "shoplite_task",
      "kind": "identity",
      "provider": "aws.iam",
      "resource_name": "shoplite-task",
      "features": ["role", "policy"],
      "usages": []
    },
    {
      "id": "dlq_not_empty",
      "kind": "monitoring",
      "provider": "aws.cloudwatch",
      "resource_name": "dlq-not-empty",
      "features": ["alarm"],
      "usages": []
    }
  ],
  "files": [],
  "env": [
    {"name": "AWS_REGION", "value": "us-east-1", "purpose": "AWS region"},
    {"name": "AWS_ENDPOINT_URL", "value": "http://127.0.0.1:4566", "purpose": "Moto endpoint"}
  ]
}
